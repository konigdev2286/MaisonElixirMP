# Configuration Supabase pour l'application de gestion de boutique (Brazzaville)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
# Clé secrète de service (uniquement utilisée côté serveur pour la création de comptes par la patronne)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete
